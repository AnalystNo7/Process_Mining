%% Схема развёртывания решения «CPS Process Mining» внутри организации.
%% Для заявки на изменение инфраструктуры (выделение мощностей под MVP).
%% Рендер: https://mermaid.live или VS Code (Markdown Preview Mermaid Support).
flowchart LR
    User["👤 Пользователи<br/>(аналитики, администратор)<br/>браузер"]
    AD[("🔐 Корпоративный AD / LDAP<br/>(опционально, на будущее)")]

    subgraph LAN["🏢 Корпоративная ЛВС"]
        direction LR

        subgraph SRV["🖥️ Сервер CPS Process Mining · 1 ВМ · 4 vCPU · 16 GB RAM · 100 GB SSD · Ubuntu 22.04 / Windows Server 2019+"]
            direction TB

            NGINX["🌐 Reverse proxy<br/>nginx / IIS<br/>:80, :443"]

            FE["⚛️ Frontend SPA<br/>React + Vite (статика)<br/>frontend/dist"]
            API["⚙️ Backend API<br/>FastAPI + uvicorn<br/>:8000 · /api/v1<br/>аутентификация: локальная (JWT)"]
            WRK["🔧 Celery worker<br/>фоновые задачи:<br/>загрузка XLSX,<br/>расчёт KPI и вариантов"]

            PG[("🐘 PostgreSQL 15+<br/>:5432 (loopback)<br/>схемы: auth · core · events")]
            REDIS[("🟥 Redis 7+<br/>:6379 (loopback)<br/>db0 кэш · db1 broker · db2 results")]
            FS[("💾 Файловое хранилище<br/>storage/ · backups/ · logs/")]

            NOTE["🔒 Порты 5432 и 6379 — только loopback (127.0.0.1).<br/>В межсетевые экраны НЕ выносятся.<br/>Снаружи открыты лишь 80/443 (от пользователей)."]
        end
    end

    User -->|"HTTPS :443"| NGINX
    NGINX -->|"статика"| FE
    NGINX -->|"REST /api/v1"| API

    API -->|"asyncpg :5432"| PG
    API -->|"db0 кэш · db1 enqueue"| REDIS
    API -->|"чтение/запись XLSX"| FS
    API -.->|"опц.: LDAP / LDAPS"| AD

    REDIS -->|"db1 задачи"| WRK
    WRK -->|"db2 результаты"| REDIS
    WRK -->|"asyncpg :5432"| PG
    WRK -->|"чтение XLSX"| FS

    classDef external fill:#e6f4ff,stroke:#1677ff,stroke-width:1px,color:#000
    classDef optional fill:#f5f5f5,stroke:#8c8c8c,stroke-width:1px,stroke-dasharray:5 4,color:#555
    classDef server fill:#fffbe6,stroke:#d48806,stroke-width:1px,color:#000
    classDef data fill:#f6ffed,stroke:#389e0d,stroke-width:1px,color:#000
    classDef proxy fill:#fff1f0,stroke:#cf1322,stroke-width:1px,color:#000
    classDef note fill:#fffbe6,stroke:#faad14,stroke-width:1px,color:#614700
    class User external
    class AD optional
    class FE,API,WRK server
    class PG,REDIS,FS data
    class NGINX proxy
    class NOTE note
