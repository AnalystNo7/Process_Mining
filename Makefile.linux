# Makefile для Linux / WSL. Использование: `make -f Makefile.linux <команда>`.
# Целевая production-среда — Windows (см. Makefile и docs/05_INFRA.md).

.PHONY: help install install-backend install-frontend migrate dev test lint format \
        backup restore verify-backup create-admin clean build-frontend run-backend \
        run-celery run-frontend

help:
	@echo "Available commands:"
	@echo "  make -f Makefile.linux install       - install all dependencies"
	@echo "  make -f Makefile.linux migrate       - apply DB migrations"
	@echo "  make -f Makefile.linux create-admin  - create first admin user (interactive)"
	@echo "  make -f Makefile.linux test          - run all tests"
	@echo "  make -f Makefile.linux lint          - run linters (ruff + mypy + eslint)"
	@echo "  make -f Makefile.linux backup        - backup DB + uploads to backups/"
	@echo "  make -f Makefile.linux restore BACKUP_DIR=...   - restore from a backup"
	@echo "  make -f Makefile.linux verify-backup BACKUP_DIR=... - check backup integrity"

install: install-backend install-frontend

install-backend:
	cd backend && python -m venv .venv
	cd backend && .venv/bin/pip install --upgrade pip
	cd backend && .venv/bin/pip install -e ".[dev]"

install-frontend:
	cd frontend && npm install

migrate:
	cd backend && .venv/bin/alembic upgrade head

create-admin:
	cd backend && .venv/bin/python -m app.scripts.create_admin

run-backend:
	cd backend && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

run-celery:
	cd backend && .venv/bin/celery -A app.celery_app worker --loglevel=info --pool=solo

run-frontend:
	cd frontend && npm run dev

dev:
	@echo "Запустите три терминала параллельно:"
	@echo "  Терминал 1: make -f Makefile.linux run-backend"
	@echo "  Терминал 2: make -f Makefile.linux run-celery"
	@echo "  Терминал 3: make -f Makefile.linux run-frontend"

test:
	cd backend && .venv/bin/pytest tests/ -v
	cd frontend && npm test

lint:
	cd backend && .venv/bin/ruff check app/ tests/
	cd backend && .venv/bin/mypy app/
	cd frontend && npm run lint

format:
	cd backend && .venv/bin/ruff format app/ tests/
	cd frontend && npm run format

# Параметры бэкапа. STORAGE_DIR — каталог хранилища (см. STORAGE_PATH в .env).
DB_HOST ?= localhost
DB_USER ?= pm_user
DB_NAME ?= process_mining
STORAGE_DIR ?= backend/storage
BACKUP_DIR ?= backups/$(shell date +%Y-%m-%d-%H%M%S)

backup:
	@echo "Создаю бэкап в $(BACKUP_DIR)..."
	@mkdir -p "$(BACKUP_DIR)/uploads"
	pg_dump -h $(DB_HOST) -U $(DB_USER) -d $(DB_NAME) -Fc -f "$(BACKUP_DIR)/db.dump"
	@cp -r "$(STORAGE_DIR)/." "$(BACKUP_DIR)/uploads/" 2>/dev/null || echo "(каталог хранилища пуст или отсутствует)"
	@python scripts/write_manifest.py "$(BACKUP_DIR)"
	@echo "Готово. Бэкап в $(BACKUP_DIR)"

restore:
	@test -f "$(BACKUP_DIR)/db.dump" || (echo "$(BACKUP_DIR)/db.dump не найден — укажите BACKUP_DIR=path"; exit 1)
	@echo "ВНИМАНИЕ! Восстановление перезапишет БД '$(DB_NAME)' и каталог $(STORAGE_DIR)!"
	@read -p "Продолжить? [y/N] " ans; [ "$$ans" = "y" ] || exit 1
	psql -h $(DB_HOST) -U $(DB_USER) -d postgres -c "DROP DATABASE IF EXISTS $(DB_NAME);"
	psql -h $(DB_HOST) -U $(DB_USER) -d postgres -c "CREATE DATABASE $(DB_NAME) OWNER $(DB_USER);"
	pg_restore -h $(DB_HOST) -U $(DB_USER) -d $(DB_NAME) "$(BACKUP_DIR)/db.dump"
	@rm -rf "$(STORAGE_DIR)"
	@mkdir -p "$(STORAGE_DIR)"
	@cp -r "$(BACKUP_DIR)/uploads/." "$(STORAGE_DIR)/" 2>/dev/null || true
	@echo "Готово."

verify-backup:
	@test -n "$(BACKUP_DIR)" || (echo "Укажите BACKUP_DIR=path/to/backup"; exit 1)
	@python scripts/verify_backup.py "$(BACKUP_DIR)"

build-frontend:
	cd frontend && npm run build

clean:
	rm -rf backend/.venv frontend/node_modules
